---
import { Fragment } from "astro/jsx-runtime";
import { posts as allPosts } from "../lib/posts";

const {
  variant = "full",
  limit,
  showHeader = false,
  showSearch = true,
  showFilters = true,
  heading = "Latest writing",
  subheading = "Search the archive or follow a topic path.",
} = Astro.props;

const visiblePosts = typeof limit === "number" ? allPosts.slice(0, limit) : allPosts;
const moduleClass = `posts-module posts-module-${variant}`;
---

<section class={moduleClass} data-posts-module>
  {showHeader && (
    <div class="posts-module-header">
      <div>
        <p class="section-kicker">Archive</p>
        <h2>{heading}</h2>
        {subheading && <p>{subheading}</p>}
      </div>
      <span class="post-count" data-post-count>{visiblePosts.length} posts</span>
    </div>
  )}

  {(showSearch || showFilters) && (
    <div class="filters-and-search">
      {showSearch && (
        <div class="post-search">
          <label class="sr-only">Search posts</label>
          <input data-post-search type="search" placeholder="Search posts... (Press / to focus)" autocomplete="off" />
        </div>
      )}

      {showFilters && (
        <div class="post-filters" data-post-filters>
          <button class="pill active" type="button" data-view="latest">Latest</button>
          <button class="pill" type="button" data-tag="ai">AI</button>
          <button class="pill" type="button" data-tag="python">Python</button>
          <button class="pill" type="button" data-tag="devops">DevOps</button>
        </div>
      )}
    </div>
  )}

  <div class="post-list" data-post-list>
    {visiblePosts.map(({ url, title, summary, minutes, searchText, tags, date }) => (
      <a
        href={url}
        class="post-card"
        data-post-card
        data-tags={tags.map((tag) => tag.toLowerCase()).join(" ")}
        data-date={new Date(date).getTime()}
        data-search={searchText}
      >
        <div class="post-title" data-title={title}>{title}</div>
        <div class="post-meta">
          <time>{date}</time>
          {tags.length > 0 && (
            <Fragment>
              <span> · </span>
              {tags.map((tag: string, index: number) => {
                const tagLower = tag.toLowerCase();
                return (
                  <Fragment>
                    {index > 0 && <span>, </span>}
                    <span
                      class="tag-link-inline"
                      data-tag-url={`/tags/${encodeURIComponent(tagLower)}/`}
                      role="link"
                      tabindex="0"
                    >
                      {tag}
                    </span>
                  </Fragment>
                );
              })}
            </Fragment>
          )}
          <span> · {minutes} min read</span>
        </div>
        {summary && <p class="post-summary">{summary}</p>}
      </a>
    ))}
  </div>
  <p class="no-results" data-no-results hidden>No posts match that search.</p>
</section>

<script>
  function escapeRegExp(value: string) {
    return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  }

  function highlightSearchTerms(element: HTMLElement, query: string) {
    const titleEl = element.querySelector("[data-title]");
    if (!titleEl) return;

    const originalText = titleEl.getAttribute("data-title") || titleEl.textContent || "";
    const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
    if (terms.length === 0) {
      titleEl.textContent = originalText;
      return;
    }

    let highlighted = originalText;
    terms.forEach((term) => {
      const regex = new RegExp(`(${escapeRegExp(term)})`, "gi");
      highlighted = highlighted.replace(regex, "<mark>$1</mark>");
    });
    titleEl.innerHTML = highlighted;
  }

  function initPostsModule(module: HTMLElement) {
    if (module.dataset.initialized === "true") return;
    module.dataset.initialized = "true";

    const list = module.querySelector("[data-post-list]");
    const items = Array.from(module.querySelectorAll("[data-post-card]")) as HTMLElement[];
    const pills = Array.from(module.querySelectorAll("[data-post-filters] .pill")) as HTMLElement[];
    const searchInput = module.querySelector("[data-post-search]") as HTMLInputElement | null;
    const postCount = module.querySelector("[data-post-count]");
    const noResults = module.querySelector("[data-no-results]") as HTMLElement | null;

    function activeControls() {
      const active = module.querySelector("[data-post-filters] .pill.active") as HTMLElement | null;
      return {
        tag: active?.getAttribute("data-tag") || "",
        view: active?.getAttribute("data-view") || "latest",
        query: searchInput?.value || "",
      };
    }

    function setActive(el: HTMLElement) {
      pills.forEach((pill) => pill.classList.toggle("active", pill === el));
    }

    function apply(view: string, tag: string, query: string) {
      if (!list) return;
      const normalizedQuery = query.trim().toLowerCase();
      let filtered = items;

      if (tag) {
        filtered = filtered.filter((el) => {
          const tags = (el.getAttribute("data-tags") || "").split(" ");
          return tags.includes(tag);
        });
      }

      if (normalizedQuery) {
        filtered = filtered.filter((el) => {
          const text = el.getAttribute("data-search") || "";
          return text.includes(normalizedQuery);
        });
      }

      filtered.sort((a, b) => {
        if (view === "popular") {
          const at = (a.getAttribute("data-tags") || "").split(" ").filter(Boolean).length;
          const bt = (b.getAttribute("data-tags") || "").split(" ").filter(Boolean).length;
          if (bt !== at) return bt - at;
        }
        return Number(b.getAttribute("data-date")) - Number(a.getAttribute("data-date"));
      });

      items.forEach((item) => highlightSearchTerms(item, ""));
      filtered.forEach((item) => {
        highlightSearchTerms(item, query);
        list.appendChild(item);
      });

      if (postCount) {
        postCount.textContent = `${filtered.length} ${filtered.length === 1 ? "post" : "posts"}`;
      }
      if (noResults) {
        noResults.hidden = filtered.length > 0;
      }
    }

    module.querySelector("[data-post-filters]")?.addEventListener("click", (event) => {
      const target = (event.target as HTMLElement).closest(".pill") as HTMLElement | null;
      if (!target) return;
      setActive(target);
      const { tag, view, query } = activeControls();
      apply(view, tag, query);
    });

    searchInput?.addEventListener("input", () => {
      const { tag, view, query } = activeControls();
      apply(view, tag, query);
    });

    apply("latest", "", searchInput?.value || "");
  }

  document.querySelectorAll("[data-posts-module]").forEach((module) => {
    initPostsModule(module as HTMLElement);
  });

  if (!(window as any).__postListEventsBound) {
    (window as any).__postListEventsBound = true;

    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement;
      const searchInput = document.querySelector("[data-post-search]") as HTMLInputElement | null;
      if (event.key === "/" && target !== searchInput && !target.isContentEditable) {
        event.preventDefault();
        searchInput?.focus();
      }
      if (event.key === "Escape" && target?.matches("[data-post-search]")) {
        const input = target as HTMLInputElement;
        input.value = "";
        input.dispatchEvent(new Event("input", { bubbles: true }));
        input.blur();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const tagLink = target.closest(".tag-link-inline");
      if (!tagLink) return;
      event.stopPropagation();
      event.preventDefault();
      const url = tagLink.getAttribute("data-tag-url");
      if (url) {
        window.location.href = url;
      }
    }, true);

    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement;
      if (!target.classList.contains("tag-link-inline") || (event.key !== "Enter" && event.key !== " ")) return;
      event.stopPropagation();
      event.preventDefault();
      const url = target.getAttribute("data-tag-url");
      if (url) {
        window.location.href = url;
      }
    }, true);
  }
</script>

<style>
  .posts-module {
    width: 100%;
  }

  .posts-module-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin: 0 0 1.25rem;
  }

  .posts-module-header h2 {
    font-family: var(--font-fancy);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1;
    margin: 0.2rem 0 0;
    letter-spacing: 0;
  }

  .posts-module-header p {
    color: var(--muted);
    max-width: 42rem;
    margin: 0.35rem 0 0;
  }

  .section-kicker {
    color: var(--accent-strong, var(--accent)) !important;
    font-family: var(--font-normal);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    margin: 0 !important;
    text-transform: uppercase;
  }

  .post-count {
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    flex: 0 0 auto;
    font-size: 0.86rem;
    padding: 0.45rem 0.8rem;
  }

  .filters-and-search {
    align-items: center;
    display: grid;
    gap: 0.85rem;
    grid-template-columns: minmax(220px, 1fr) auto;
    margin: 1rem 0 0;
  }

  .post-search {
    width: 100%;
  }

  .post-search input[type="search"] {
    background: color-mix(in oklab, var(--bg) 94%, white);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    font-family: var(--font-normal);
    font-size: 1rem;
    padding: 0.82rem 1rem;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    width: 100%;
  }

  .post-search input[type="search"]:focus {
    border-color: var(--accent-strong, var(--accent));
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent-strong, var(--accent)) 18%, transparent);
    outline: none;
  }

  .post-search input[type="search"]::placeholder {
    color: var(--muted);
  }

  .post-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    justify-content: flex-end;
  }

  .pill {
    appearance: none;
    background: color-mix(in oklab, var(--bg) 96%, white);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    cursor: pointer;
    font-family: var(--font-normal);
    font-size: 0.9rem;
    padding: 0.62rem 0.9rem;
  }

  .pill:hover,
  .pill:focus-visible {
    border-color: var(--accent-strong, var(--accent));
    outline: none;
  }

  .pill.active {
    background: var(--accent-strong, var(--accent));
    border-color: var(--accent-strong, var(--accent));
    color: var(--ink-inverted);
  }

  .post-list {
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
    padding: 1.1rem 0 0;
  }

  .post-card {
    border-bottom: 1px solid var(--line);
    border-left: 3px solid transparent;
    display: block;
    padding: 1.1rem 1rem 1.1rem calc(1rem - 3px);
    position: relative;
    text-decoration: none;
    transition: background 160ms ease, border-left-color 160ms ease, transform 160ms ease;
  }

  .post-card:hover {
    background: color-mix(in oklab, var(--bg) 93%, var(--ink));
    border-left-color: var(--accent-strong, var(--accent));
    color: var(--ink);
    transform: translateX(2px);
  }

  .post-title {
    color: var(--ink);
    display: block;
    font-family: var(--font-fancy);
    font-size: clamp(1.45rem, 3vw, 1.9rem);
    line-height: 1.1;
  }

  .post-meta {
    color: var(--muted);
    display: block;
    font-family: var(--font-normal);
    font-size: 0.88rem;
    line-height: 1.5;
    margin-top: 0.45rem;
  }

  .post-summary {
    color: var(--muted);
    margin: 0.55rem 0 0;
    max-width: 64rem;
  }

  .tag-link-inline {
    color: var(--accent-strong, var(--accent));
    cursor: pointer;
    text-decoration: none;
  }

  .tag-link-inline:hover {
    text-decoration: underline;
  }

  .tag-link-inline:focus {
    outline: 2px solid var(--accent-strong, var(--accent));
    outline-offset: 2px;
  }

  .no-results {
    border: 1px dashed var(--line);
    border-radius: 8px;
    color: var(--muted);
    margin: 1rem 0 0;
    padding: 1.25rem;
    text-align: center;
  }

  mark {
    background: color-mix(in oklab, #f7c948 45%, transparent);
    border-radius: 3px;
    color: inherit;
    padding: 0 2px;
  }

  .sr-only {
    border: 0;
    clip: rect(0, 0, 0, 0);
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .posts-module-home .post-list {
    gap: 0.65rem;
    padding-top: 1rem;
  }

  .posts-module-home .post-card {
    background: color-mix(in oklab, var(--bg) 95%, white);
    border: 1px solid var(--line);
    border-left: 3px solid transparent;
    border-radius: 8px;
  }

  @media (max-width: 760px) {
    .posts-module-header,
    .filters-and-search {
      align-items: stretch;
      grid-template-columns: 1fr;
    }

    .posts-module-header {
      flex-direction: column;
    }

    .post-count {
      align-self: flex-start;
    }

    .post-filters {
      justify-content: flex-start;
    }
  }
</style>
