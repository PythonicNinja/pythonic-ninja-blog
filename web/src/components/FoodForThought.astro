---
const {
  raindropUri = "https://raindrop.io/vojtek-nowak/food-for-thought-62612689/embed/sort=-created",
  fullyCollapsed = false,
} = Astro.props;
---

<section
  class="food-for-thought"
  data-food-for-thought
  data-fully-collapsed={fullyCollapsed}
  data-src={raindropUri}
>
  <button
    type="button"
    class="btn food-toggle"
    aria-expanded="false"
    data-food-toggle
  >
    Show food for thought
  </button>
  <iframe
    allowfullscreen
    data-food-frame
    frameborder="0"
    loading="lazy"
    title="Food for thought"
  ></iframe>
</section>

<script>
  function initFoodForThought(container: HTMLElement) {
    if (container.dataset.initialized === "true") return;
    container.dataset.initialized = "true";

    const button = container.querySelector("[data-food-toggle]") as HTMLButtonElement | null;
    const iframe = container.querySelector("[data-food-frame]") as HTMLIFrameElement | null;
    const fullyCollapsed = container.getAttribute("data-fully-collapsed") === "true";
    const src = container.getAttribute("data-src") || "";
    let expanded = false;

    function ensureLoaded() {
      if (iframe && src && iframe.getAttribute("src") !== src) {
        iframe.setAttribute("src", src);
      }
    }

    function render() {
      if (!button || !iframe) return;
      const preview = !fullyCollapsed && !expanded;
      if (expanded || preview) {
        ensureLoaded();
      }
      iframe.style.height = expanded ? "520px" : (preview ? "64px" : "0px");
      iframe.style.borderWidth = expanded || preview ? "1px" : "0";
      iframe.setAttribute("aria-hidden", expanded || preview ? "false" : "true");
      button.setAttribute("aria-expanded", expanded ? "true" : "false");
      button.textContent = expanded ? "Hide food for thought" : "Show food for thought";
    }

    button?.addEventListener("click", () => {
      expanded = !expanded;
      render();
    });

    render();
  }

  document.querySelectorAll("[data-food-for-thought]").forEach((container) => {
    initFoodForThought(container as HTMLElement);
  });
</script>

<style>
  .food-for-thought {
    align-items: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
  }

  .food-toggle {
    min-height: 40px;
    padding: 0.58rem 0.9rem;
  }

  .food-for-thought iframe {
    border-color: var(--line);
    border-radius: 8px;
    border-style: solid;
    margin-top: 1rem;
    transition: height 0.28s ease-in-out, border-width 0.28s ease-in-out;
    width: 100%;
  }
</style>
